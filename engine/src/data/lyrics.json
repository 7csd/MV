[
  {
    "time": 0,
    "text": "希望我们 有光明的未来"
  },
  {
    "time": 2.77,
    "text": "还有能够装下星空的期待"
  },
  {
    "time": 5.677,
    "text": "可现实为何让我感到如此懈怠"
  },
  {
    "time": 8.799,
    "text": "总怀念相遇时我们无视落叶和人海"
  },
  {
    "time": 12.128,
    "text": ""
  },
  {
    "time": 12.408,
    "text": "是你让我勇敢不再像颗尘埃"
  },
  {
    "time": 15.128,
    "text": "是你常帮我照料装着梦的盆栽"
  },
  {
    "time": 18,
    "text": "每一天我们都是如此愉快"
  },
  {
    "time": 20.798000000000002,
    "text": "一直到天色渐晚看着落日无奈离开"
  },
  {
    "time": 24.179,
    "text": ""
  },
  {
    "time": 24.399,
    "text": "我知道你爱集邮爱笑甚至爱发呆"
  },
  {
    "time": 27.14,
    "text": "我知道你怕草虫还有夜晚的妖怪"
  },
  {
    "time": 30.099,
    "text": "我喜欢你有一点心不在焉的状态"
  },
  {
    "time": 33.28,
    "text": "看起来像个回到七岁时候的小孩"
  },
  {
    "time": 36.119,
    "text": ""
  },
  {
    "time": 36.39,
    "text": "该如何将我这份感情向你告白"
  },
  {
    "time": 38.869,
    "text": "喜欢却又不敢爱"
  },
  {
    "time": 40.44,
    "text": "直到整个宇宙"
  },
  {
    "time": 42.319,
    "text": "在为我焦虑失神慌张之中醒来"
  },
  {
    "time": 45.08,
    "text": "就像是黑暗过后黎明盛开"
  },
  {
    "time": 47.059,
    "text": ""
  },
  {
    "time": 47.497,
    "text": "我们之间的回忆"
  },
  {
    "time": 50.22,
    "text": "全部都小心地收集"
  },
  {
    "time": 53.14,
    "text": "我总是偷偷地哭泣"
  },
  {
    "time": 56.22,
    "text": "像倦鸟失了归期"
  },
  {
    "time": 59.039,
    "text": "但愿我相信的爱情"
  },
  {
    "time": 62.03,
    "text": "结局紧握在我手心"
  },
  {
    "time": 65.069,
    "text": "时光匆匆却没有遗失过去"
  },
  {
    "time": 72.679,
    "text": ""
  }
